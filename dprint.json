{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "includes": [
        "**/*.json",
        "**/*.jsonc",
        "**/*.md"
    ],
    "excludes": [
        "**/.git/**",
        "**/.svn/**",
        "**/.hg/**"
    ],
    "indentWidth": 4,
    "lineWidth": 120,
    "markdown": {
        "textWrap": "always"
    },
    "plugins": [
        "https://plugins.dprint.dev/json-0.21.3.wasm",
        "https://plugins.dprint.dev/markdown-0.21.1.wasm",
        "https://plugins.dprint.dev/dockerfile-0.4.1.wasm"
    ]
}
